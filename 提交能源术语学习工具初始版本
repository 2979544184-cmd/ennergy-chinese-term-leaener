const modalImg = document.getElementById('modalImg');
const modalClose = document.getElementById('modalClose');
const speakBtn = document.getElementById('speakBtn');
const termGrid = document.getElementById('termGrid');
const collectGrid = document.getElementById('collectGrid');
const filterBar = document.getElementById('filterBar');
const tabs = document.querySelectorAll('.tab');
const views = document.querySelectorAll('.view');

// Tab切换
tabs.forEach(tab=>{
  tab.onclick = ()=>{
    const target = tab.dataset.tab;
    tabs.forEach(t=>t.classList.remove('active'));
    tab.classList.add('active');
    views.forEach(v=>v.classList.remove('active'));
    document.getElementById(target + 'View').classList.add('active');
    if(target === 'list') renderTermList();
    if(target === 'collect') renderCollectList();
  }
})

// 弹窗关闭
modalClose.onclick = ()=> modal.style.display = 'none';
modal.onclick = (e)=>{ if(e.target === modal) modal.style.display = 'none'; }

// 朗读英文
speakBtn.onclick = ()=>{
  const utter = new SpeechSynthesisUtterance(modalExplain.innerText);
  utter.lang = 'en-US';
  speechSynthesis.speak(utter);
}

// 打开词条弹窗
function openModal(item){
  modalZh.innerText = item.zh;
  modalEn.innerText = item.en;
  modalCat.innerText = item.category;
  modalExplain.innerText = item.explain_en;
  modalImg.src = item.img_url;
  modal.style.display = 'flex';
}

// 生成分类筛选按钮
function buildFilter(){
  const cats = [...new Set(termLib.map(i=>i.category))];
  filterBar.innerHTML = '';
  const allBtn = document.createElement('button');
  allBtn.className = 'filter-btn active';
  allBtn.innerText = '全部';
  allBtn.onclick = ()=>{
    document.querySelectorAll('.filter-btn').forEach(b=>b.classList.remove('active'));
    allBtn.classList.add('active');
    currentFilterCat = null;
    renderTermList();
  }
  filterBar.appendChild(allBtn);
  cats.forEach(cat=>{
    const btn = document.createElement('button');
    btn.className = 'filter-btn';
    btn.innerText = cat;
    btn.onclick = ()=>{
      document.querySelectorAll('.filter-btn').forEach(b=>b.classList.remove('active'));
      btn.classList.add('active');
      currentFilterCat = cat;
      renderTermList();
    }
    filterBar.appendChild(btn);
  })
}

// 渲染词汇列表
function renderTermList(){
  let list = termLib;
  if(currentFilterCat) list = termLib.filter(x=>x.category === currentFilterCat);
  termGrid.innerHTML = '';
  list.forEach(item=>{
    const card = makeCard(item);
    termGrid.appendChild(card);
  })
}

// 渲染生词本
function renderCollectList(){
  collectGrid.innerHTML = '';
  collectList.forEach(item=>{
    const card = makeCard(item);
    collectGrid.appendChild(card);
  })
}

// 制作卡片DOM
function makeCard(item){
  const div = document.createElement('div');
  div.className = 'term-card';
  const isCollected = collectList.some(x=>x.zh === item.zh);
  div.innerHTML = `
    <img src="${item.img_url}" alt="${item.zh}">
    <div class="term-card-body">
      <div style="display:flex;justify-content:space-between;align-items:center">
        <h3>${item.zh}</h3>
        <span class="star ${isCollected?'active':''}" data-zh="${item.zh}">⭐</span>
      </div>
      <p style="color:#444;font-size:14px">${item.en}</p>
      <span class="tag">${item.category}</span>
    </div>
  `;
  div.querySelector('img').onclick = ()=> openModal(item);
  div.querySelector('h3').onclick = ()=> openModal(item);
  const star = div.querySelector('.star');
  star.onclick = (e)=>{
    e.stopPropagation();
    const idx = collectList.findIndex(x=>x.zh === item.zh);
    if(idx >=0){
      collectList.splice(idx,1);
    }else{
      collectList.push(item);
    }
    renderTermList();
    renderCollectList();
  }
  return div;
}

// 解析文本，长词优先匹配
parseBtn.onclick = ()=>{
  let txt = inputText.value;
  // 长词优先排序
  const sortedTerms = [...termLib].sort((a,b)=>b.zh.length - a.zh.length);
  for(const t of sortedTerms){
    const reg = new RegExp(t.zh, 'g');
    txt = txt.replace(reg, `<span class="term-hit" data-zh="${t.zh}">${t.zh}</span>`);
  }
  readerBox.innerHTML = txt;
  // 绑定高亮点击事件
  readerBox.querySelectorAll('.term-hit').forEach(span=>{
    span.onclick = ()=>{
      const zh = span.dataset.zh;
      const item = termLib.find(x=>x.zh === zh);
      if(item) openModal(item);
    }
  })
}

// 清空按钮
clearBtn.onclick = ()=>{
  inputText.value = '';
  readerBox.innerText = '解析后文本将展示在这里';
}

// 初始化
buildFilter();
renderTermList();
</script>
</body>
</html>
